class RunnerHome extends StatefulWidget {
const RunnerHome({super.key});

@override
State<RunnerHome> createState() => _RunnerHomeState();
}

class Obstacle {
int lane;
double y; // 0..1 normalized vertical position (0 top, 1 bottom)
Obstacle({required this.lane, required this.y});
}

class _RunnerHomeState extends State<RunnerHome> with TickerProviderStateMixin {
static const int laneCount = 3;
final Random rng = Random();

// Player state
int playerLane = 1; // middle lane
double playerJump = 0.0; // 0 = ground, >0 = in air
double jumpVelocity = 0.0;
final double gravity = 0.012;
final double jumpForce = 0.28;

// Obstacles
final List<Obstacle> obstacles = <Obstacle>[];
double spawnTimer = 0.0;
double spawnInterval = 1.2; // seconds
double gameSpeed = 0.45; // how fast obstacles move (higher = faster)
int score = 0;
bool playing = false;
bool isGamePaused = false;
Timer? gameLoop;

// UI sizing
static const double trackPadding = 24.0;

@override
void initState() {
super.initState();
resetGame();
}

@override
void didChangeDependencies() {
super.didChangeDependencies();
// Update game parameters when settings change, or on initial load
_applyDifficultySettings(context.watch<GameSettings>().difficulty);
}

void _applyDifficultySettings(Difficulty difficulty) {
switch (difficulty) {
case Difficulty.easy:
spawnInterval = 1.6;
gameSpeed = 0.35;
break;
case Difficulty.medium:
spawnInterval = 1.2;
gameSpeed = 0.45;
break;
case Difficulty.hard:
spawnInterval = 0.8;
gameSpeed = 0.60;
break;
}
}

void resetGame() {
gameLoop?.cancel();
obstacles.clear();
playerLane = 1;
playerJump = 0.0;
jumpVelocity = 0.0;
spawnTimer = 0.0;
score = 0;
playing = false;
isGamePaused = false;
_applyDifficultySettings(
context.read<GameSettings>().difficulty); // Apply current settings
setState(() {});
}

void startGame() {
if (playing && !isGamePaused) return; // Already playing and not paused
if (playing && isGamePaused) {
resumeGame();
return;
}

playing = true;
isGamePaused = false;
// initial obstacles
obstacles.clear();
for (int i = 0; i < 2; i++) {
obstacles.add(Obstacle(lane: rng.nextInt(laneCount), y: -i * 0.5 - 0.7));
}

final int fps = 60;
final double dt = 1 / fps;
gameLoop = Timer.periodic(Duration(milliseconds: (dt * 1000).toInt()),
(Timer _) {
updateGame(dt);
});
setState(() {}); // Update UI to reflect 'playing' state
}

void pauseGame() {
if (!playing || isGamePaused) return;
gameLoop?.cancel();
isGamePaused = true;
setState(() {});
}

void resumeGame() {
if (!playing || !isGamePaused) return;
isGamePaused = false;
final int fps = 60;
final double dt = 1 / fps;
gameLoop = Timer.periodic(Duration(milliseconds: (dt * 1000).toInt()),
(Timer _) {
updateGame(dt);
});
setState(() {});
}

void updateGame(double dt) {
if (!playing || isGamePaused) return;

// update jump physics
if (playerJump > 0 || jumpVelocity != 0) {
jumpVelocity += gravity;
playerJump -= jumpVelocity;
if (playerJump <= 0) {
playerJump = 0;
jumpVelocity = 0;
}
}

// move obstacles downward (increase y)
for (Obstacle ob in obstacles) {
ob.y += gameSpeed * dt;
}

// spawn new obstacles
spawnTimer += dt;
if (spawnTimer >= spawnInterval) {
spawnTimer = 0;
// space next obstacle a bit and ensure not impossible
final int lane = rng.nextInt(laneCount);
obstacles.add(Obstacle(lane: lane, y: -0.4));
// increase difficulty slowly, based on initial difficulty
final Difficulty currentDifficulty =
context.read<GameSettings>().difficulty;
if (currentDifficulty == Difficulty.easy) {
if (spawnInterval > 1.0) spawnInterval -= 0.01;
if (gameSpeed < 0.8) gameSpeed += 0.005;
} else if (currentDifficulty == Difficulty.medium) {
if (spawnInterval > 0.6) spawnInterval -= 0.02;
if (gameSpeed < 1.6) gameSpeed += 0.01;
} else if (currentDifficulty == Difficulty.hard) {
if (spawnInterval > 0.4) spawnInterval -= 0.03;
if (gameSpeed < 2.2) gameSpeed += 0.015;
}
}

// remove obstacles that passed bottom and increase score
obstacles.removeWhere((Obstacle ob) {
if (ob.y > 1.25) {
score += 5;
return true;
}
return false;
});

// collision detection: player is at y ~ 0.9 (bottom). If obstacle y near player and same lane and playerJump small => collision
for (Obstacle ob in obstacles) {
if (ob.lane == playerLane) {
if (ob.y > 0.72 && ob.y < 0.96) {
if (playerJump < 0.28) {
// collision
endGame();
return;
}
}
}
}

setState(() {});
}

void endGame() {
gameLoop?.cancel();
playing = false;
isGamePaused = false;

// Save the current score as the previous score
context.read<GameSettings>().setPreviousScore(score);
final int currentScore = score; // Capture score for dialog
final int previousScore =
context.read<GameSettings>().previousScore; // Use the newly set previous score

Future<void>.delayed(const Duration(milliseconds: 100), () {
showDialog<void>(
context: context,
barrierDismissible: false,
builder: (BuildContext c) => AlertDialog(
title: const Text('Game Over!'),
content: Column(
mainAxisSize: MainAxisSize.min,
crossAxisAlignment: CrossAxisAlignment.start,
children: <Widget>[
Text('Your score: $currentScore'),
Text('Previous score: $previousScore'),
],
),
actions: <Widget>[
TextButton(
onPressed: () {
Navigator.pop(c);
resetGame();
},
child: const Text('Exit'),
),
TextButton(
onPressed: () {
Navigator.pop(c);
resetGame();
startGame();
},
child: const Text('Restart'),
),
],
),
);
});
}

void moveLeft() {
if (!playing || isGamePaused) return;
if (playerLane > 0) {
setState(() => playerLane--);
}
}

void moveRight() {
if (!playing || isGamePaused) return;
if (playerLane < laneCount - 1) {
setState(() => playerLane++);
}
}

void jump() {
if (!playing || isGamePaused) return;
if (playerJump <= 0) {
jumpVelocity = -jumpForce;
playerJump = 0.0001; // start jump
}
}

// simple helper to position lanes
double laneX(int laneIndex, double width) {
final double laneWidth = (width - trackPadding * 2) / laneCount;
final double left = trackPadding + laneIndex * laneWidth + laneWidth / 2;
return left;
}

@override
void dispose() {
gameLoop?.cancel();
super.dispose();
}

