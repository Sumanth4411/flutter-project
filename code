class _PlayerColorSelector extends StatelessWidget {
final List<Color> availableColors = const <Color>[
Colors.indigo,
Colors.deepOrange,
Colors.green,
Colors.purple,
Colors.teal,
];

const _PlayerColorSelector();

@override
Widget build(BuildContext context) {
final Color currentColor = context.watch<GameSettings>().playerColor;

return Wrap(
spacing: 10.0,
runSpacing: 10.0,
children: availableColors.map<Widget>((Color color) {
return GestureDetector(
onTap: () {
context.read<GameSettings>().updatePlayerColor(color);
},
child: Container(
width: 50,
height: 50,
decoration: BoxDecoration(
color: color,
shape: BoxShape.circle,
border: Border.all(
color:
currentColor == color ? Colors.blueAccent : Colors.transparent,
width: 3,
),
boxShadow: currentColor == color
? <BoxShadow>[
BoxShadow(
color: color.withAlpha((255 * 0.6).round()),
blurRadius: 8)
]
: null,
),
child: currentColor == color
? const Icon(Icons.check, color: Colors.white)
: null,
),
);
}).toList(),
);
}
