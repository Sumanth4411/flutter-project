class ObstacleWidget extends StatelessWidget {
final Obstacle obstacle;
final double screenWidth;
final double boardHeight;
final double laneWidth;
final double Function(int, double) laneX; // Function to get lane's x position

const ObstacleWidget({
super.key,
required this.obstacle,
required this.screenWidth,
required this.boardHeight,
required this.laneWidth,
required this.laneX,
});

@override
Widget build(BuildContext context) {
final double leftCenter = laneX(obstacle.lane, screenWidth);
// Convert ob.y (normalized) to pixel Y within board:
final double pixelY = (obstacle.y.clamp(-1.0, 1.5)) * boardHeight;
// obstacle size
final double obsWidth = laneWidth * 0.6;
final double obsHeight = 48.0;

return Positioned(
left: leftCenter - obsWidth / 2,
top: pixelY,
width: obsWidth,
height: obsHeight,
child: Container(
decoration: BoxDecoration(
color: Colors.orange.shade700,
borderRadius: BorderRadius.circular(8),
boxShadow: const <BoxShadow>[
BoxShadow(color: Colors.black26, blurRadius: 4)
],
),
child: Center(
child: Text(
'OB',
style: TextStyle(
color: Colors.white.withAlpha((255 * 0.9).round()),
fontWeight: FontWeight.bold),
),
),
),
);
}
}

