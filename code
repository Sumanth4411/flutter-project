// Enum for difficulty levels
enum Difficulty {
easy,
medium,
hard,
}

// Data Model for game settings
class GameSettings extends ChangeNotifier {
Difficulty _difficulty;
Color _playerColor;
int _previousScore; // Added to store the score from the last completed game

GameSettings()
: _difficulty = Difficulty.medium,
_playerColor = Colors.indigo,
_previousScore = 0; // Initialize previous score

Difficulty get difficulty => _difficulty;
Color get playerColor => _playerColor;
int get previousScore => _previousScore; // Getter for previous score

void updateDifficulty(Difficulty newDifficulty) {
if (_difficulty != newDifficulty) {
_difficulty = newDifficulty;
notifyListeners();
}
}

void updatePlayerColor(Color newColor) {
if (_playerColor != newColor) {
_playerColor = newColor;
notifyListeners();
}
}

// Method to update the previous score
void setPreviousScore(int newScore) {
if (_previousScore != newScore) {
_previousScore = newScore;
notifyListeners();
}
}
}

